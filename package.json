{
  "name": "loop-shelf",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.12.0"
  },
  "scripts": {
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.web.json && tsc --noEmit -p tsconfig.worker.json",
    "test": "node --test tests/*.test.ts",
    "check": "npm run typecheck && npm run build && npm test",
    "inspect:source": "node scripts/inspect-source.ts",
    "start": "node --env-file-if-exists=.env src/server/main.ts",
    "db:migrate": "node --env-file-if-exists=.env scripts/database.ts migrate",
    "db:backup": "node --env-file-if-exists=.env scripts/database.ts backup",
    "db:restore": "node --env-file-if-exists=.env scripts/database.ts restore",
    "catalog:remove": "node --env-file-if-exists=.env scripts/catalog.ts remove",
    "catalog:review": "node --env-file-if-exists=.env scripts/catalog.ts review",
    "catalog:adopt": "node --env-file-if-exists=.env scripts/catalog.ts adopt",
    "account:create": "node --env-file-if-exists=.env scripts/account.ts create",
    "account:reset-password": "node --env-file-if-exists=.env scripts/account.ts reset-password",
    "dev": "node --env-file-if-exists=.env src/server/main.ts --dev",
    "build": "vite build",
    "icons": "node scripts/generate-icons.ts",
    "test:e2e": "npm run build && playwright test",
    "bench:catalog": "node scripts/bench-catalog.ts",
    "bench:retention": "node scripts/bench-catalog-retention.ts"
  },
  "dependencies": {
    "@fastify/rate-limit": "11.2.1",
    "@fastify/static": "10.1.6",
    "better-auth": "1.7.10",
    "better-sqlite3": "13.0.3",
    "cheerio": "1.2.0",
    "fastify": "5.12.7",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@fastify/middie": "9.3.6",
    "@playwright/test": "1.64.1",
    "@types/better-sqlite3": "9.6.0",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "typescript": "7.0.2",
    "vite": "8.3.5"
  }
}
